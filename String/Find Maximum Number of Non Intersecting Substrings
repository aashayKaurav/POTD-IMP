You are given a string word.

Return the maximum number of non-intersecting substrings of word that are at least four characters long and start and end with the same letter.

Example 1:

Input: word = "abcdeafdef"

Output: 2

Explanation:

The two substrings are "abcdea" and "fdef".

Example 2:

Input: word = "bcdaaaab"

Output: 1

Explanation:

The only substring is "aaaa". Note that we cannot also choose "bcdaaaab" since it intersects with the other substring.

Constraints:

1 <= word.length <= 2 * 105
word consists only of lowercase English letters.



---------------------------------------------------------------------------------------------------------------------------------------------------

Brute Force : Generate all the substrings, meeting the 2 conditions and store as intervals. Then sort based on second index value to find the non-overlapping intervals.
              

class Solution {
public:
    int maxSubstrings(string word) {
        int n = word.size();
        
        if(n < 4) {
            return 0;
        }
        
        vector<pair<int, int>> intervals;
        
        for(int i=0; i<n; i++) {
            for(int j=i+3; j<n; j++) {
                if(word[i] == word[j]) {
                    intervals.push_back({i, j});
                }
            }
        }
        
        if(intervals.size() == 0) {
            return 0;
        }
        sort(intervals.begin(), intervals.end(), [](auto &a, auto &b){
            return a.second < b.second;
        });
        
        pair<int, int> temp = intervals[0];
        int count = 0, lastIndex = -1;
        
        for(auto it : intervals) {
            if(it.first > lastIndex) {
                count++;
                lastIndex = it.second;
            }
        }
        
        return count;
    }
};

Time Complexity  : O(N^2)
Space Complexity : O(N)
