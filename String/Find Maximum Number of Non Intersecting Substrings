Optimal Solution:

class Solution {
public:
    // Try not to generate all the substrings. We just need to meet 2 conditions for which we only need indices of each letter.
    // Try to find closest indices that satisfy (Min Length >= 4) to make more substrings.
    // Get all the intervals for each letter possible. Then extract the ones which are non-overlapping. 
    int maxSubstrings(string word) {
        int n = word.size();
        
        if(n < 4) {
            return 0;
        }
        
        unordered_map<char, vector<int>> map;
        vector<pair<int, int>> intervals;

        for(int i=0; i<n; i++) {
            map[word[i]].push_back(i);
        }

        for(auto it: map) {
            vector<int>& pos = it.second;
            int len = pos.size();
            for(int i = 0; i < len; ++i) {
                for(int j = i + 1; j < len; ++j) {
                    if(pos[j] - pos[i] + 1 >= 4) {
                        intervals.push_back({pos[i], pos[j]});
                        break;      // we want the smallest interval for this i
                    }
                }
            }
        }

        sort(intervals.begin(), intervals.end(), [](auto &a, auto &b) {
            return a.second < b.second;
        });

        int ans = 0, lastIndex = -1;
        for (auto &it : intervals) {
            if(lastIndex < it.first) {
                ans++;
                lastIndex = it.second;
            }
        }

        return ans;
    }
};

Time Complexity  : O(N * LogN)
Space Complexity : O(N)


